   243	- [ ] **Step 3: Write minimal implementation**
   244	
   245	```ts
   246	export type Rng = () => number;
   247	
   248	export function mulberry32(seed: number): Rng {
   249	  let a = seed >>> 0;
   250	  return function () {
   251	    a |= 0;
   252	    a = (a + 0x6d2b79f5) | 0;
   253	    let t = Math.imul(a ^ (a >>> 15), 1 | a);
   254	    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
   255	    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
   256	  };
   257	}
   258	
   259	export function randRange(rng: Rng, min: number, max: number): number {
   260	  return min + (max - min) * rng();
   261	}
   262	
   263	export function randInt(rng: Rng, minInclusive: number, maxInclusive: number): number {
   264	  return minInclusive + Math.floor(rng() * (maxInclusive - minInclusive + 1));
   265	}
   266	```
