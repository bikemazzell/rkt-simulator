  2035	type SfxName = 'launch' | 'whoosh' | 'chute' | 'boom';
  2036	
  2037	const TONES: Record<SfxName, { freq: number; dur: number; type: OscillatorType }> = {
  2038	  launch: { freq: 90, dur: 0.6, type: 'sawtooth' },
  2039	  whoosh: { freq: 300, dur: 0.3, type: 'sine' },
  2040	  chute: { freq: 500, dur: 0.15, type: 'triangle' },
  2041	  boom: { freq: 60, dur: 0.5, type: 'square' },
  2042	};
  2043	
  2044	export class Sfx {
  2045	  muted = true;
  2046	  private ctx: AudioContext | null = null;
  2047	
  2048	  private ensureCtx(): AudioContext | null {
  2049	    if (this.ctx) return this.ctx;
  2050	    try {
  2051	      const Ctor = (globalThis as any).AudioContext ?? (globalThis as any).webkitAudioContext;
  2052	      if (!Ctor) return null;
  2053	      this.ctx = new Ctor();
  2054	      return this.ctx;
  2055	    } catch {
  2056	      return null;
  2057	    }
  2058	  }
  2059	
  2060	  toggleMute(): boolean {
  2061	    this.muted = !this.muted;
  2062	    return this.muted;
  2063	  }
  2064	
  2065	  play(name: SfxName): void {
  2066	    if (this.muted) return;
  2067	    const ctx = this.ensureCtx();
  2068	    if (!ctx) return;
  2069	    try {
  2070	      const { freq, dur, type } = TONES[name];
  2071	      const osc = ctx.createOscillator();
  2072	      const gain = ctx.createGain();
  2073	      osc.type = type;
  2074	      osc.frequency.value = freq;
  2075	      gain.gain.setValueAtTime(0.2, ctx.currentTime);
  2076	      gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + dur);
  2077	      osc.connect(gain).connect(ctx.destination);
  2078	      osc.start();
  2079	      osc.stop(ctx.currentTime + dur);
  2080	    } catch {
  2081	      // Audio is best-effort; never block a launch.
  2082	    }
  2083	  }
  2084	}
  2085	```
