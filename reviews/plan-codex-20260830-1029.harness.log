  1287	```ts
  1288	import type { ChallengeConfig, ChallengeResult, EnvParams, FlightSummary, Vec3 } from './types';
  1289	import { horizontalDistance } from './vec';
  1290	
  1291	export function scoreChallenge(
  1292	  config: ChallengeConfig, env: EnvParams, summary: FlightSummary, landing: Vec3,
  1293	): ChallengeResult {
  1294	  if (config.type === 'target-altitude') {
  1295	    const target = config.targetAltitudeM ?? 100;
  1296	    const tol = config.toleranceM ?? 50;
  1297	    const err = Math.abs(summary.apogee - target);
  1298	    const score = Math.max(0, Math.round(100 * (1 - err / tol)));
  1299	    return { score, detail: `apogee ${summary.apogee.toFixed(0)} m vs target ${target} m` };
  1300	  }
  1301	  if (config.type === 'landing-zone') {
  1302	    const zone = env.targetZone;
  1303	    if (!zone) return { score: 0, detail: 'no landing zone in this environment' };
  1304	    const dist = horizontalDistance(landing, zone.center);
  1305	    const score = dist >= zone.radius ? 0 : Math.round(100 * (1 - dist / zone.radius));
  1306	    return { score, detail: `landed ${dist.toFixed(0)} m from zone center` };
  1307	  }
  1308	  return { score: 0, detail: 'no challenge' };
  1309	}
  1310	```
