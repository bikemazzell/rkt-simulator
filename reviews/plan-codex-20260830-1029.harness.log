  1146	- [ ] **Step 3: Write `src/sim/outcomes.ts`**
  1147	
  1148	```ts
  1149	import type { FlightState, SimConfig } from './types';
  1150	import { G } from './integrator';
  1151	import type { Rng } from './rng';
  1152	
  1153	export type DecisionPoint = 'ignition' | 'apogee';
  1154	
  1155	const BASE_CHUTE_FAIL = 0.04;
  1156	const TUMBLE_CHUTE_FAIL = 0.15;
  1157	const BASE_TIPOFF = 0.05;
  1158	
  1159	export function catoProbability(config: SimConfig): number {
  1160	  const { motor, rocket } = config;
  1161	  const overload = motor.totalImpulseNs / rocket.maxMotorImpulseNs;
  1162	  if (overload <= 1) return 0.01; // small baseline
  1163	  return Math.min(0.9, 0.01 + (overload - 1) * 0.8);
  1164	}
  1165	
  1166	export function chuteFailProbability(config: SimConfig): number {
  1167	  return config.rocket.chuteDiameterM === 0 ? TUMBLE_CHUTE_FAIL : BASE_CHUTE_FAIL;
  1168	}
  1169	
  1170	export function tipOffProbability(config: SimConfig): number {
  1171	  const { motor, rocket } = config;
  1172	  const liftoffMass = rocket.massEmptyKg + motor.massTotalKg;
  1173	  const twr = motor.avgThrustN / (liftoffMass * G);
  1174	  return twr < 1.2 ? BASE_TIPOFF + (1.2 - twr) * 0.3 : 0;
  1175	}
  1176	
  1177	export function applyOutcome(
  1178	  state: FlightState, config: SimConfig, rng: Rng, point: DecisionPoint,
  1179	): void {
  1180	  if (point === 'ignition') {
  1181	    if (rng() < catoProbability(config)) {
  1182	      state.phase = 'failed';
  1183	      state.outcome = 'cato';
  1184	      return;
  1185	    }
  1186	    if (rng() < tipOffProbability(config)) {
  1187	      state.outcome = 'tip-off';
  1188	      // Angled kick: bleed some vertical energy into horizontal.
  1189	      state.velocity = { x: 2, y: state.velocity.y, z: 1 };
  1190	    }
  1191	    return;
  1192	  }
  1193	  // apogee
  1194	  if (rng() < chuteFailProbability(config)) {
  1195	    if (state.outcome === null) state.outcome = 'chute-fail';
  1196	    state.chuteDeployed = false;
  1197	  } else {
  1198	    state.chuteDeployed = config.rocket.chuteDiameterM > 0;
  1199	    if (state.outcome === null) state.outcome = 'nominal';
  1200	  }
  1201	}
  1202	```
