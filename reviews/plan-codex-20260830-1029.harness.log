   966	import type { SimConfig, FlightState, FlightSummary, Vec3 } from './types';
   967	import { initialFlightState, advancePhase } from './flight';
   968	import { thrustAt } from './thrustCurve';
   969	import { stepMotion } from './integrator';
   970	import { windAt } from './atmosphere';
   971	import { vec, horizontalDistance, length } from './vec';
   972	import { mulberry32, type Rng } from './rng';
   973	import { applyOutcome } from './outcomes';
   974	
   975	export const DT = 1 / 120;
   976	
   977	export class Simulation {
   978	  readonly state: FlightState;
   979	  private readonly config: SimConfig;
   980	  private readonly rng: Rng;
   981	  private readonly launchPos: Vec3;
   982	
   983	  constructor(config: SimConfig) {
   984	    this.config = config;
   985	    this.rng = mulberry32(config.seed);
   986	    this.state = initialFlightState(config);
   987	    this.launchPos = { ...this.state.position };
   988	  }
   989	
   990	  get done(): boolean {
   991	    return this.state.phase === 'landed' || this.state.phase === 'failed';
   992	  }
   993	
   994	  step(): void {
   995	    if (this.done) return;
   996	    const s = this.state;
   997	    const { rocket, motor, environment } = this.config;
   998	
   999	    if (s.phase === 'idle') {
  1000	      s.phase = 'boost';
  1001	      applyOutcome(s, this.config, this.rng, 'ignition');
  1002	      if (s.phase === 'failed') return;
  1003	    }
  1004	
  1005	    s.time += DT;
  1006	
  1007	    const thrustN = s.phase === 'boost' ? thrustAt(motor, s.time) : 0;
  1008	    const burnedProp = motor.massPropKg * Math.min(1, s.time / motor.burnTimeS);
  1009	    s.mass = rocket.massEmptyKg + motor.massTotalKg - burnedProp;
  1010	
  1011	    const useChute = s.chuteDeployed;
  1012	    const refArea = useChute
  1013	      ? Math.PI * (rocket.chuteDiameterM / 2) ** 2
  1014	      : Math.PI * (rocket.diameterM / 2) ** 2;
  1015	    const cd = useChute ? rocket.chuteCd : rocket.dragCoefficient;
  1016	
  1017	    const next = stepMotion({
  1018	      position: s.position, velocity: s.velocity, mass: s.mass,
  1019	      thrustN, refArea, dragCoefficient: cd,
  1020	      wind: windAt(environment.wind, this.rng), dt: DT,
  1021	    });
  1022	    s.position = next.position;
  1023	    s.velocity = next.velocity;
  1024	
  1025	    s.apogee = Math.max(s.apogee, s.position.y - environment.groundHeight);
  1026	    s.maxSpeed = Math.max(s.maxSpeed, length(s.velocity));
  1027	
  1028	    const nextPhase = advancePhase(s, motor);
  1029	    if (nextPhase !== s.phase) {
  1030	      s.phase = nextPhase;
  1031	      if (s.phase === 'apogee') applyOutcome(s, this.config, this.rng, 'apogee');
  1032	    }
  1033	
  1034	    if (s.position.y <= environment.groundHeight) {
  1035	      s.position = vec(s.position.x, environment.groundHeight, s.position.z);
  1036	      s.velocity = vec(0, 0, 0);
  1037	      if (s.phase !== 'failed') s.phase = 'landed';
  1038	      if (s.outcome === null) s.outcome = 'nominal';
  1039	    }
  1040	  }
  1041	
  1042	  summary(): FlightSummary {
  1043	    const s = this.state;
  1044	    return {
  1045	      apogee: s.apogee,
  1046	      maxSpeed: s.maxSpeed,
  1047	      flightTime: s.time,
  1048	      outcome: s.outcome ?? 'nominal',
  1049	      driftDistanceM: horizontalDistance(this.launchPos, s.position),
  1050	    };
  1051	  }
  1052	}
  1053	```
