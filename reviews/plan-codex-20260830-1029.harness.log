   608	import type { Vec3, Wind } from './types';
   609	import { vec } from './vec';
   610	import { randRange, type Rng } from './rng';
   611	
   612	const SEA_LEVEL_DENSITY = 1.225; // kg/m^3
   613	const SCALE_HEIGHT = 8500;       // m, exponential atmosphere approximation
   614	
   615	export function airDensity(altitudeM: number): number {
   616	  const h = Math.max(0, altitudeM);
   617	  return SEA_LEVEL_DENSITY * Math.exp(-h / SCALE_HEIGHT);
   618	}
   619	
   620	export function windAt(wind: Wind, rng: Rng): Vec3 {
   621	  const gx = randRange(rng, -wind.gust, wind.gust);
   622	  const gz = randRange(rng, -wind.gust, wind.gust);
   623	  return vec(wind.base.x + gx, 0, wind.base.z + gz);
   624	}
   625	```
