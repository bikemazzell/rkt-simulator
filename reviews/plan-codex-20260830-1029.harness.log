  1743	
  1744	**Interfaces:**
  1745	- Consumes: `three`, `Rocket`/`RocketLook`.
  1746	- Produces: `buildRocketMesh(rocket: Rocket): THREE.Group` — a low-poly rocket (body cylinder, nose cone, `finCount` fins) scaled to look right; oriented along `+y`. Also `buildParachute(): THREE.Mesh` and `buildFlame(): THREE.Mesh` reused by effects.
  1747	
  1748	- [ ] **Step 1: Write `src/world/rocketMesh.ts`**
  1749	
  1750	```ts
  1751	import * as THREE from 'three';
  1752	import type { Rocket } from '../sim/types';
  1753	
  1754	export function buildRocketMesh(rocket: Rocket): THREE.Group {
  1755	  const g = new THREE.Group();
  1756	  const L = rocket.look;
  1757	  // Exaggerate diameter for visibility (rockets are thin at real scale).
  1758	  const radius = Math.max(0.4, rocket.diameterM * 12);
  1759	  const bodyLen = Math.max(3, L.bodyLengthM * 8);
  1760	
  1761	  const body = new THREE.Mesh(
  1762	    new THREE.CylinderGeometry(radius, radius, bodyLen, 12),
  1763	    new THREE.MeshLambertMaterial({ color: L.bodyColor }),
  1764	  );
  1765	  body.position.y = bodyLen / 2;
  1766	  g.add(body);
  1767	
  1768	  const nose = new THREE.Mesh(
  1769	    new THREE.ConeGeometry(radius, radius * 3, 12),
  1770	    new THREE.MeshLambertMaterial({ color: L.noseColor }),
  1771	  );
  1772	  nose.position.y = bodyLen + radius * 1.5;
  1773	  g.add(nose);
  1774	
  1775	  const finMat = new THREE.MeshLambertMaterial({ color: L.finColor, side: THREE.DoubleSide });
  1776	  const finShape = new THREE.Shape();
  1777	  finShape.moveTo(0, 0); finShape.lineTo(radius * 2, 0);
  1778	  finShape.lineTo(radius * 2, radius * 1.5); finShape.lineTo(0, radius * 3); finShape.lineTo(0, 0);
  1779	  const finGeo = new THREE.ShapeGeometry(finShape);
  1780	  for (let i = 0; i < L.finCount; i++) {
  1781	    const fin = new THREE.Mesh(finGeo, finMat);
  1782	    const angle = (i / L.finCount) * Math.PI * 2;
  1783	    fin.position.set(Math.cos(angle) * radius, 0, Math.sin(angle) * radius);
  1784	    fin.rotation.y = -angle;
  1785	    g.add(fin);
  1786	  }
  1787	  return g;
  1788	}
  1789	
  1790	export function buildParachute(color = 0xff5533): THREE.Mesh {
  1791	  const geo = new THREE.SphereGeometry(4, 12, 8, 0, Math.PI * 2, 0, Math.PI / 2);
  1792	  return new THREE.Mesh(geo, new THREE.MeshLambertMaterial({ color, side: THREE.DoubleSide }));
  1793	}
  1794	
  1795	export function buildFlame(): THREE.Mesh {
  1796	  const geo = new THREE.ConeGeometry(0.5, 3, 8);
  1797	  geo.rotateX(Math.PI); // point downward
  1798	  const mesh = new THREE.Mesh(geo, new THREE.MeshBasicMaterial({ color: 0xffa500 }));
  1799	  return mesh;
  1800	}
