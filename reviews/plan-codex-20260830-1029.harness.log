  1831	```ts
  1832	import * as THREE from 'three';
  1833	import { OrbitControls } from 'three/examples/jsm/controls/OrbitControls.js';
  1834	import type { Vec3 } from '../sim/types';
  1835	
  1836	export type CameraMode = 'orbit' | 'follow';
  1837	
  1838	export class SceneManager {
  1839	  readonly scene = new THREE.Scene();
  1840	  readonly worldGroup = new THREE.Group();
  1841	  private readonly renderer: THREE.WebGLRenderer;
  1842	  private readonly camera: THREE.PerspectiveCamera;
  1843	  private readonly controls: OrbitControls;
  1844	  private mode: CameraMode = 'orbit';
  1845	
  1846	  constructor(private readonly host: HTMLElement) {
  1847	    this.renderer = new THREE.WebGLRenderer({ antialias: true });
  1848	    this.renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  1849	    host.appendChild(this.renderer.domElement);
  1850	    this.scene.add(this.worldGroup);
  1851	
  1852	    this.camera = new THREE.PerspectiveCamera(60, 1, 0.1, 5000);
  1853	    this.camera.position.set(40, 30, 60);
  1854	
  1855	    this.controls = new OrbitControls(this.camera, this.renderer.domElement);
  1856	    this.controls.enableDamping = true;
  1857	    this.resize();
  1858	    window.addEventListener('resize', () => this.resize());
  1859	  }
  1860	
  1861	  setCameraMode(mode: CameraMode): void { this.mode = mode; }
  1862	
  1863	  clearWorld(): void {
  1864	    for (const child of [...this.worldGroup.children]) {
  1865	      this.worldGroup.remove(child);
  1866	      child.traverse((obj) => {
  1867	        const mesh = obj as THREE.Mesh;
  1868	        mesh.geometry?.dispose?.();
  1869	        const mat = mesh.material;
  1870	        if (Array.isArray(mat)) mat.forEach((m) => m.dispose());
  1871	        else mat?.dispose?.();
  1872	      });
  1873	    }
  1874	  }
  1875	
  1876	  reset(): void {
  1877	    this.camera.position.set(40, 30, 60);
  1878	    this.controls.target.set(0, 10, 0);
  1879	    this.controls.update();
  1880	  }
  1881	
  1882	  render(rocketPos: Vec3): void {
  1883	    if (this.mode === 'follow') {
  1884	      const target = new THREE.Vector3(rocketPos.x, rocketPos.y, rocketPos.z);
  1885	      const desired = target.clone().add(new THREE.Vector3(30, 15, 40));
  1886	      this.camera.position.lerp(desired, 0.08);
  1887	      this.controls.target.lerp(target, 0.2);
  1888	    }
  1889	    this.controls.update();
  1890	    this.renderer.render(this.scene, this.camera);
  1891	  }
  1892	
  1893	  resize(): void {
  1894	    const w = this.host.clientWidth || window.innerWidth;
  1895	    const h = this.host.clientHeight || window.innerHeight;
  1896	    this.renderer.setSize(w, h);
  1897	    this.camera.aspect = w / h;
  1898	    this.camera.updateProjectionMatrix();
  1899	  }
  1900	}
  1901	```
