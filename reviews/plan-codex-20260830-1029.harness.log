   508	```ts
   509	import type { Motor } from './types';
   510	
   511	const RISE_FRAC = 0.15;
   512	const TAPER_FRAC = 0.25;
   513	
   514	// Unscaled shape in [0, 1]: linear rise, flat sustain, linear taper.
   515	function shape(tNorm: number): number {
   516	  if (tNorm <= 0 || tNorm >= 1) return 0;
   517	  if (tNorm < RISE_FRAC) return tNorm / RISE_FRAC;
   518	  if (tNorm > 1 - TAPER_FRAC) return (1 - tNorm) / TAPER_FRAC;
   519	  return 1;
   520	}
   521	
   522	// Analytic mean of `shape` over [0,1] (area of the trapezoid / 1).
   523	const SHAPE_MEAN = 1 - RISE_FRAC / 2 - TAPER_FRAC / 2;
   524	
   525	function peakThrust(motor: Motor): number {
   526	  // avgThrust = peak * SHAPE_MEAN, but scale to totalImpulse for exactness.
   527	  return motor.totalImpulseNs / (motor.burnTimeS * SHAPE_MEAN);
   528	}
   529	
   530	export function thrustAt(motor: Motor, t: number): number {
   531	  if (t < 0 || t > motor.burnTimeS) return 0;
   532	  return peakThrust(motor) * shape(t / motor.burnTimeS);
   533	}
   534	
   535	export function integrateImpulse(motor: Motor, dt = 0.001): number {
   536	  let sum = 0;
   537	  for (let t = 0; t < motor.burnTimeS; t += dt) {
   538	    sum += thrustAt(motor, t + dt / 2) * dt;
   539	  }
   540	  return sum;
   541	}
