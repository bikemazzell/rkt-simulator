   729	- [ ] **Step 3: Write `src/sim/integrator.ts`**
   730	
   731	```ts
   732	import type { Vec3 } from './types';
   733	import { vec, add, sub, scale, length } from './vec';
   734	import { airDensity } from './atmosphere';
   735	
   736	export const G = 9.81;
   737	
   738	export interface StepInput {
   739	  position: Vec3;
   740	  velocity: Vec3;
   741	  mass: number;
   742	  thrustN: number;
   743	  refArea: number;
   744	  dragCoefficient: number;
   745	  wind: Vec3;
   746	  dt: number;
   747	}
   748	
   749	export function stepMotion(input: StepInput): { position: Vec3; velocity: Vec3 } {
   750	  const { position, velocity, mass, thrustN, refArea, dragCoefficient, wind, dt } = input;
   751	
   752	  // Air-relative velocity for drag.
   753	  const airVel = sub(velocity, wind);
   754	  const speed = length(airVel);
   755	  const rho = airDensity(position.y);
   756	  const dragMag = 0.5 * rho * speed * speed * dragCoefficient * refArea;
   757	  const dragForce = speed > 0 ? scale(airVel, -dragMag / speed) : vec(0, 0, 0);
   758	
   759	  const thrustForce = vec(0, thrustN, 0);
   760	  const gravityForce = vec(0, -G * mass, 0);
   761	  const netForce = add(add(thrustForce, gravityForce), dragForce);
   762	
   763	  const accel = scale(netForce, 1 / mass);
   764	
   765	  // Semi-implicit Euler: update velocity, then position with new velocity.
   766	  const newVelocity = add(velocity, scale(accel, dt));
   767	  const newPosition = add(position, scale(newVelocity, dt));
   768	  return { position: newPosition, velocity: newVelocity };
   769	}
   770	```
