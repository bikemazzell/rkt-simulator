   418	import type { Vec3 } from './types';
   419	
   420	export const vec = (x: number, y: number, z: number): Vec3 => ({ x, y, z });
   421	export const add = (a: Vec3, b: Vec3): Vec3 => vec(a.x + b.x, a.y + b.y, a.z + b.z);
   422	export const sub = (a: Vec3, b: Vec3): Vec3 => vec(a.x - b.x, a.y - b.y, a.z - b.z);
   423	export const scale = (a: Vec3, s: number): Vec3 => vec(a.x * s, a.y * s, a.z * s);
   424	export const length = (a: Vec3): number => Math.hypot(a.x, a.y, a.z);
   425	
   426	export function normalize(a: Vec3): Vec3 {
   427	  const len = length(a);
   428	  return len === 0 ? vec(0, 0, 0) : scale(a, 1 / len);
   429	}
   430	
   431	export function horizontalDistance(a: Vec3, b: Vec3): number {
   432	  return Math.hypot(a.x - b.x, a.z - b.z);
   433	}
   434	```
