   860	- [ ] **Step 4: Write `src/sim/flight.ts`**
   861	
   862	```ts
   863	import type { FlightState, FlightPhase, Motor, SimConfig } from './types';
   864	import { vec } from './vec';
   865	
   866	export function initialFlightState(config: SimConfig): FlightState {
   867	  return {
   868	    time: 0,
   869	    position: vec(0, config.environment.groundHeight, 0),
   870	    velocity: vec(0, 0, 0),
   871	    mass: config.rocket.massEmptyKg + config.motor.massTotalKg,
   872	    phase: 'idle',
   873	    outcome: null,
   874	    apogee: 0,
   875	    maxSpeed: 0,
   876	    chuteDeployed: false,
   877	  };
   878	}
   879	
   880	export function advancePhase(state: FlightState, motor: Motor): FlightPhase {
   881	  const burning = state.time <= motor.burnTimeS;
   882	  switch (state.phase) {
   883	    case 'boost':
   884	      return burning ? 'boost' : 'coast';
   885	    case 'coast':
   886	      return state.velocity.y <= 0 ? 'apogee' : 'coast';
   887	    case 'apogee':
   888	      return 'descent';
   889	    default:
   890	      return state.phase;
   891	  }
   892	}
   893	```
