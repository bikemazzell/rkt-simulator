  1512	
  1513	```ts
  1514	import type { EnvParams, Vec3 } from '../../sim/types';
  1515	import { vec } from '../../sim/vec';
  1516	import { mulberry32, randRange, type Rng } from '../../sim/rng';
  1517	
  1518	function windVec(rng: Rng, minSpeed: number, maxSpeed: number): Vec3 {
  1519	  const speed = randRange(rng, minSpeed, maxSpeed);
  1520	  const angle = randRange(rng, 0, Math.PI * 2);
  1521	  return vec(Math.cos(angle) * speed, 0, Math.sin(angle) * speed);
  1522	}
  1523	
  1524	function zone(rng: Rng, radius: number, zoneRadius: number) {
  1525	  const r = randRange(rng, radius * 0.2, radius * 0.6);
  1526	  const a = randRange(rng, 0, Math.PI * 2);
  1527	  return { center: vec(Math.cos(a) * r, 0, Math.sin(a) * r), radius: zoneRadius };
  1528	}
  1529	
  1530	export function parkParams(rng: Rng): EnvParams {
  1531	  return { groundHeight: 0, wind: { base: windVec(rng, 1, 4), gust: 1.5 }, bounds: { radius: 400 }, targetZone: zone(rng, 400, 25) };
  1532	}
  1533	export function urbanParams(rng: Rng): EnvParams {
  1534	  return { groundHeight: 0, wind: { base: windVec(rng, 2, 5), gust: 4 }, bounds: { radius: 350 }, targetZone: zone(rng, 350, 20) };
  1535	}
  1536	export function mountainParams(rng: Rng): EnvParams {
  1537	  return { groundHeight: 1200, wind: { base: windVec(rng, 3, 7), gust: 3 }, bounds: { radius: 600 }, targetZone: zone(rng, 600, 30) };
  1538	}
  1539	export function desertParams(rng: Rng): EnvParams {
  1540	  return { groundHeight: 300, wind: { base: windVec(rng, 0.5, 2), gust: 1 }, bounds: { radius: 700 }, targetZone: zone(rng, 700, 30) };
  1541	}
  1542	export function seaParams(rng: Rng): EnvParams {
  1543	  return { groundHeight: 0, wind: { base: windVec(rng, 5, 10), gust: 4 }, bounds: { radius: 800 }, targetZone: zone(rng, 800, 35) };
  1544	}
  1545	export function rooftopParams(rng: Rng): EnvParams {
  1546	  return { groundHeight: 12, wind: { base: windVec(rng, 2, 6), gust: 3 }, bounds: { radius: 250 }, targetZone: zone(rng, 250, 15) };
  1547	}
  1548	export function bathtubParams(rng: Rng): EnvParams {
  1549	  return { groundHeight: 0, wind: { base: windVec(rng, 0, 1), gust: 0.5 }, bounds: { radius: 60 }, targetZone: zone(rng, 60, 8) };
  1550	}
  1551	export function backyardDogParams(rng: Rng): EnvParams {
  1552	  return { groundHeight: 0, wind: { base: windVec(rng, 1, 3), gust: 2 }, bounds: { radius: 120 }, targetZone: zone(rng, 120, 12) };
  1553	}
  1554	
  1555	const MAKERS: Record<string, (rng: Rng) => EnvParams> = {
  1556	  park: parkParams, urban: urbanParams, mountain: mountainParams, desert: desertParams,
  1557	  sea: seaParams, rooftop: rooftopParams, bathtub: bathtubParams, 'backyard-dog': backyardDogParams,
  1558	};
  1559	
  1560	export function makeParamsFor(id: string, seed: number): EnvParams {
  1561	  const maker = MAKERS[id];
  1562	  if (!maker) throw new Error(`unknown environment: ${id}`);
  1563	  return maker(mulberry32(seed));
  1564	}
  1565	```
