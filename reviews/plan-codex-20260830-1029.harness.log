  1514	import type { EnvParams, Vec3 } from '../../sim/types';
  1515	import { vec } from '../../sim/vec';
  1516	import { mulberry32, randRange, type Rng } from '../../sim/rng';
  1517	
  1518	function windVec(rng: Rng, minSpeed: number, maxSpeed: number): Vec3 {
  1519	  const speed = randRange(rng, minSpeed, maxSpeed);
  1520	  const angle = randRange(rng, 0, Math.PI * 2);
  1521	  return vec(Math.cos(angle) * speed, 0, Math.sin(angle) * speed);
  1522	}
  1523	
  1524	function zone(rng: Rng, radius: number, zoneRadius: number) {
  1525	  const r = randRange(rng, radius * 0.2, radius * 0.6);
  1526	  const a = randRange(rng, 0, Math.PI * 2);
  1527	  return { center: vec(Math.cos(a) * r, 0, Math.sin(a) * r), radius: zoneRadius };
  1528	}
  1529	
